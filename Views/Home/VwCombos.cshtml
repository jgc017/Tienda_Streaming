@model List<Tienda_Streaming.Models.Dto.Administracion.RegistrarPublicaciones.DtoInicioContenidoItem>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Combos";
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    var contacto = ViewBag.Contacto as Tienda_Streaming.Models.Dto.Administracion.RegistrarPublicaciones.DtoInicioContenidoItem;
    var items = Model ?? new();
    var combosTienda = ViewBag.Combos as List<Tienda_Streaming.Models.Dto.Administracion.RegistrarProductos.DtoComboItem> ?? new();
    var videoUrl = ViewBag.VideoUrl as string;
    var youtubeEmbedUrl = ObtenerYoutubeEmbedAutoplay(videoUrl);
    var esVideoLocal = EsArchivoVideo(videoUrl);

    var combosBase = new[]
    {
        new
        {
            Id = "combo-estandar",
            Nombre = "Combo Estandar",
            Descripcion = "Seleccion de productos para empezar con una opcion sencilla y clara.",
            Imagen = Url.Content("~/img/inicio/inicio_20260719214523_241e71ef03004eb59d695c987351e10b.jpeg")
        },
        new
        {
            Id = "combo-familiar",
            Nombre = "Combo Familiar",
            Descripcion = "Paquete visual para quienes prefieren una combinacion mas completa.",
            Imagen = Url.Content("~/img/inicio/inicio_20260719213942_f7e1eab3e63e415a8f2826683e882311.jpeg")
        },
        new
        {
            Id = "combo-total",
            Nombre = "Combo Total",
            Descripcion = "Opcion amplia con mejor cobertura y acompanamiento prioritario.",
            Imagen = Url.Content("~/img/inicio/inicio_20260719205317_547a647b5efb4cbb8fd00774f1bb39cf.jpg")
        }
    };
}

<input type="hidden" id="csrfToken" value="@csrfToken" />

<section class="public-home public-store-shell" data-tipo-usuario="@ViewBag.IdTipoUsuarioTienda" data-cart-context="@(User.Identity?.IsAuthenticated == true ? "interna" : "publica")" data-compra-habilitada="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_StoreHorizontalNav" />
    }
    else
    {
        <partial name="_PublicHomeNav" />
    }

    <main class="public-store-layout">
        <section id="combosCarousel" class="carousel slide public-home-carousel public-store-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators">
                @if (items.Any())
                {
                    for (var i = 0; i < items.Count; i++)
                    {
                        <button type="button" data-bs-target="#combosCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : null)" aria-label="Combo @(i + 1)"></button>
                    }
                }
                else
                {
                    <button type="button" data-bs-target="#combosCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Combos"></button>
                }
            </div>
            <div class="carousel-inner">
                @if (items.Any())
                {
                    for (var i = 0; i < items.Count; i++)
                    {
                        var item = items[i];
                        var imagen = !string.IsNullOrWhiteSpace(item.ImagenUrl) ? Url.Content(item.ImagenUrl) : combosBase[i % combosBase.Length].Imagen;
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <article class="public-carousel-slide">
                                <img class="public-carousel-image" src="@imagen" alt="@item.Titulo" />
                                <div class="public-carousel-copy">
                                    <span class="public-home-kicker">Combos</span>
                                    <h1>@item.Titulo</h1>
                                    <p>@(item.Resumen ?? "Elige un combo, define la cantidad y revisa el total desde el carrito.")</p>
                                </div>
                            </article>
                        </div>
                    }
                }
                else
                {
                    <div class="carousel-item active">
                        <article class="public-carousel-slide">
                            <img class="public-carousel-image" src="@combosBase[0].Imagen" alt="Combos" />
                            <div class="public-carousel-copy">
                                <span class="public-home-kicker">Tienda publica</span>
                                <h1>Combos</h1>
                                <p>Elige un combo, define la cantidad y revisa el total desde el carrito.</p>
                            </div>
                        </article>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#combosCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#combosCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </section>

        <section class="public-store-video" aria-label="Video destacado de combos">
            @if (!string.IsNullOrWhiteSpace(youtubeEmbedUrl))
            {
                <iframe class="public-video-frame" src="@youtubeEmbedUrl" title="Video de combos" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            }
            else if (esVideoLocal)
            {
                <video class="public-video-frame" src="@Url.Content(videoUrl!)" autoplay muted playsinline controls loop></video>
            }
            else
            {
                <div class="public-video-placeholder">
                    <i class="fa-solid fa-play"></i>
                    <span>Video destacado</span>
                </div>
            }
        </section>

        <section class="public-product-grid" aria-label="Productos de combos">
            @if (combosTienda.Any())
            {
                foreach (var combo in combosTienda)
                {
                    var imagenProducto = !string.IsNullOrWhiteSpace(combo.ImagenUrl) ? Url.Content(combo.ImagenUrl) : combosBase[0].Imagen;
                    var comboAgotado = combo.CantidadDisponible <= 0;
                    var precioData = combo.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    <article class="public-product-card">
                        <div class="public-product-media">
                            <div class="public-product-heading">
                                <h2>@combo.Nombre</h2>
                                @if (!string.IsNullOrWhiteSpace(combo.Descripcion))
                                {
                                    <p class="public-product-description">@combo.Descripcion</p>
                                }
                            </div>
                            <img class="public-product-photo" src="@imagenProducto" alt="@combo.Nombre" />
                            <div class="public-product-options">
                                <div class="public-product-option">
                                    <div class="public-product-option-row">
                                        <div class="public-product-option-summary">
                                            <strong>@combo.Tiempo_Pantalla dias</strong>
                                            <span class="public-product-option-price">$@combo.Precio.ToString("N0")</span>
                                        </div>
                                        <label class="public-product-qty-label">
                                            Cantidad
                                            <input type="number" min="1" max="@combo.CantidadDisponible" value="1" class="public-product-qty" aria-label="Cantidad para @combo.Nombre" disabled="@comboAgotado" />
                                        </label>
                                    </div>
                                    <span class="@(comboAgotado ? "table-status table-status-inactive" : "table-status table-status-active")">Disponibles: @combo.CantidadDisponible</span>
                                    <button type="button" class="btn btn-primary public-add-cart" data-product-type="Combo" data-combo-id="@combo.Id_Combo" data-name="@combo.Nombre" data-price="@precioData" data-stock="@combo.CantidadDisponible" data-duration="@combo.Tiempo_Pantalla" disabled="@comboAgotado">
                                        <i class="fa-solid fa-cart-plus me-2"></i> Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="public-store-empty">No hay productos disponibles por ahora.</div>
            }
        </section>

        <section class="public-store-contact" id="contacto">
            <div class="section-title-row">
                <h2>Contacto</h2>
                <span>Atencion</span>
            </div>
            <p>@(contacto?.Resumen ?? contacto?.Contenido ?? "Para confirmar disponibilidad, tiempos de entrega o resolver dudas, comunicate con el administrador de la tienda.")</p>
            <a asp-controller="Home" asp-action="VwContacto">Ver canales de contacto</a>
        </section>
    </main>
</section>

<div id="purchaseResultModal" class="modal-custom">
    <div class="modal-content-custom modal-content-wide purchase-result-card">
        <div class="modal-header-custom">
            <h5 class="modal-title"><i class="fa-solid fa-circle-check me-2"></i>Compra Confirmada</h5>
            <button type="button" class="btn-close-custom" id="purchaseResultClose" aria-label="Cerrar">x</button>
        </div>
        <div class="modal-body-custom">
            <div id="purchaseResultBody"></div>
        </div>
        <div class="modal-footer-custom">
            <button type="button" id="purchaseResultCopyAll" class="btn btn-secondary">Copiar todo</button>
            <button type="button" id="purchaseResultCloseFooter" class="btn btn-primary">Aceptar</button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/public-store.js" asp-append-version="true"></script>
    <script type="module" src="~/js/cart-3d.js" asp-append-version="true"></script>
}

@functions {
    private static string? ObtenerYoutubeEmbedAutoplay(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || !Uri.TryCreate(url.Trim(), UriKind.Absolute, out var uri))
        {
            return null;
        }

        var host = uri.Host.ToLowerInvariant();
        string? videoId = null;

        if (host.Contains("youtu.be"))
        {
            videoId = LimpiarYoutubeId(uri.AbsolutePath.Trim('/'));
        }
        else if (host.Contains("youtube.com") || host.Contains("youtube-nocookie.com"))
        {
            var segmentos = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

            if (segmentos.Length >= 2
                && (segmentos[0].Equals("embed", StringComparison.OrdinalIgnoreCase)
                    || segmentos[0].Equals("shorts", StringComparison.OrdinalIgnoreCase)
                    || segmentos[0].Equals("live", StringComparison.OrdinalIgnoreCase)
                    || segmentos[0].Equals("v", StringComparison.OrdinalIgnoreCase)))
            {
                videoId = LimpiarYoutubeId(segmentos[1]);
            }
            else if (uri.AbsolutePath.Equals("/watch", StringComparison.OrdinalIgnoreCase))
            {
                videoId = uri.Query.TrimStart('?')
                    .Split('&', StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Split('=', 2))
                    .Where(p => p.Length == 2 && p[0].Equals("v", StringComparison.OrdinalIgnoreCase))
                    .Select(p => LimpiarYoutubeId(Uri.UnescapeDataString(p[1])))
                    .FirstOrDefault();
            }
        }

        return string.IsNullOrWhiteSpace(videoId)
            ? null
            : $"https://www.youtube.com/embed/{videoId}?autoplay=1&mute=1&playsinline=1&rel=0";
    }

    private static string? LimpiarYoutubeId(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var id = value.Split('/', '?', '&').FirstOrDefault() ?? string.Empty;
        return new string(id.Where(c => char.IsLetterOrDigit(c) || c == '_' || c == '-').ToArray());
    }

    private static bool EsArchivoVideo(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        var limpio = url.Split('?', '#')[0];
        return limpio.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase)
            || limpio.EndsWith(".webm", StringComparison.OrdinalIgnoreCase)
            || limpio.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase);
    }
}



