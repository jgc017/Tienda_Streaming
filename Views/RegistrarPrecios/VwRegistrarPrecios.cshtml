@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Registrar Precios";
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

@section Scripts {
    <script src="~/js/administracion/registrarprecios.js" asp-append-version="true"></script>
}

<input type="hidden" id="csrfToken" value="@csrfToken" />
<input type="hidden" id="txtIdPrecioProducto" />

<nav aria-label="breadcrumb" class="breadcrumb-wrapper">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="VwIndex">Inicio</a></li>
        <li class="breadcrumb-item">Registrar Precios</li>
    </ol>
</nav>

<div class="container-fluid">
    <div class="card custom-card border-primary">
        <div class="card-header d-flex align-items-center custom-card-header">
            <h4 class="card-title text-white d-flex align-items-center">
                <i class="fa-solid fa-tags text-white me-2"></i>
                Registrar Precios
            </h4>
        </div>
        <div class="card-body collapse show">
            <div class="row form-flex">
                <div class="col-12 col-md-3 custom-input-group">
                    <div class="form-group has-float-label select-float-label">
                        @Html.DropDownList("ddlPrecioPlataforma", ViewBag.ddlPlataformas as IEnumerable<SelectListItem>, "Seleccione una opcion", new { id = "ddlPrecioPlataforma", @class = "form-control floating-select select2" })
                        <label class="floating-label">Plataforma</label>
                    </div>
                </div>
                <div class="col-12 col-md-3 custom-input-group">
                    <div class="form-group has-float-label select-float-label">
                        @Html.DropDownList("ddlPrecioTipoUsuario", ViewBag.ddlTiposUsuario as IEnumerable<SelectListItem>, "Seleccione una opcion", new { id = "ddlPrecioTipoUsuario", @class = "form-control floating-select select2" })
                        <label class="floating-label">Tipo usuario</label>
                    </div>
                </div>
                <div class="col-12 col-md-2 custom-input-group">
                    <div class="form-group has-float-label">
                        <input id="txtPrecioTiempoPantalla" type="number" min="1" step="1" class="form-control floating-input input-blue" placeholder=" " />
                        <label class="floating-label">Dias pantalla</label>
                    </div>
                </div>
                <div class="col-12 col-md-2 custom-input-group">
                    <div class="form-group has-float-label">
                        <input id="txtPrecioValor" type="number" min="1" step="0.01" class="form-control floating-input input-blue" placeholder=" " />
                        <label class="floating-label">Precio</label>
                    </div>
                </div>
                <div class="col-12 col-md-2 custom-input-group">
                    <div class="form-status-editor">
                        <label class="form-status-label">Estado</label>
                        <div class="form-toggle-container"><input type="checkbox" id="chkPrecioVigente"></div>
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2 mt-3 mb-3">
                    <button type="button" id="BtnNuevoPrecio" class="btn btn-success btn-fixed">
                        <i class="fa-solid fa-file-circle-plus me-2"></i> Nuevo
                    </button>
                    <button type="button" id="BtnGuardarPrecio" class="btn-form-action btn-fixed">
                        <i class="fa-solid fa-save me-2"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card custom-card border-primary">
        <div class="card-header d-flex align-items-center custom-card-header">
            <h4 class="card-title text-white d-flex align-items-center">
                <i class="fa-solid fa-list text-white me-2"></i>
                Lista Precios
            </h4>
        </div>
        <div class="card-body collapse show">
            <div class="table-responsive m-t-40" style="margin-top: 0 !important;">
                <table class="table-custom align-middle" id="tablaPrecios"></table>
            </div>
        </div>
    </div>
</div>
