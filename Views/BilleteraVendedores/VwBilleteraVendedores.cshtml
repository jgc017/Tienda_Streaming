@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Billetera Vendedores";
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

@section Scripts {
    <script src="~/js/administracion/billeteravendedores.js" asp-append-version="true"></script>
}

<input type="hidden" id="csrfToken" value="@csrfToken" />
<input type="hidden" id="txtIdBilletera" />

<nav aria-label="breadcrumb" class="breadcrumb-wrapper">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="VwIndex">Inicio</a></li>
        <li class="breadcrumb-item">Billetera Vendedores</li>
    </ol>
</nav>

<div class="container-fluid">
    <div class="card custom-card border-primary">
        <div class="card-header d-flex align-items-center custom-card-header">
            <h4 class="card-title text-white d-flex align-items-center">
                <i class="fa-solid fa-wallet text-white me-2"></i>
                Recargar Billetera
            </h4>
        </div>
        <div class="card-body collapse show">
            <div class="row form-flex">
                <div class="col-12 col-md-6 custom-input-group">
                    <div class="form-group has-float-label select-float-label">
                        @Html.DropDownList("ddlBilleteraUsuario", ViewBag.ddlUsuarios as IEnumerable<SelectListItem>, "Seleccione una opcion", new { id = "ddlBilleteraUsuario", @class = "form-control floating-select select2" })
                        <label class="floating-label">Vendedor</label>
                    </div>
                </div>
                <div class="col-12 col-md-6 custom-input-group">
                    <div class="form-group has-float-label">
                        <input id="txtBilleteraValor" type="number" min="0" step="0.01" class="form-control floating-input input-blue" placeholder=" " />
                        <label class="floating-label">Valor / saldo</label>
                    </div>
                </div>
                <div class="col-12 col-md-6 custom-input-group">
                    <div class="form-group has-float-label">
                        <input id="txtBilleteraDescripcion" type="text" class="form-control floating-input input-blue" placeholder=" " />
                        <label class="floating-label">Descripcion</label>
                    </div>
                </div>
                <div class="col-12 col-md-6 custom-input-group">
                    <div class="form-status-editor">
                        <label class="form-status-label">Estado</label>
                        <div class="form-toggle-container"><input type="checkbox" id="chkBilleteraVigente"></div>
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2 mt-3 mb-3">
                    <button type="button" id="BtnNuevaRecarga" class="btn btn-success btn-fixed">
                        <i class="fa-solid fa-file-circle-plus me-2"></i> Nuevo
                    </button>
                    <button type="button" id="BtnRecargarBilletera" class="btn-form-action btn-fixed">
                        <i class="fa-solid fa-save me-2"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card custom-card border-primary">
        <div class="card-header d-flex align-items-center custom-card-header">
            <h4 class="card-title text-white d-flex align-items-center">
                <i class="fa-solid fa-list text-white me-2"></i>
                Lista Billeteras
            </h4>
        </div>
        <div class="card-body collapse show">
            <div class="table-responsive m-t-40" style="margin-top: 0 !important;">
                <table class="table-custom align-middle" id="tablaBilleteras"></table>
            </div>
        </div>
    </div>
</div>
