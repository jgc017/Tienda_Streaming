@model Tienda_Streaming.Models.Dto.Account.DtoForgotPasswordViewModel

@{
    // Pantalla publica de recuperacion; no usa el layout interno del proyecto.
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar contrasena";
}

@* Envia el correo a POST /Account/ForgotPassword. El controlador siempre
   responde con confirmacion generica para no revelar si la cuenta existe. *@
<form asp-action="ForgotPassword" method="post" class="auth-form">
    <h2 class="auth-form-title">Recuperar contrasena</h2>
    <p class="auth-form-copy">
        Ingresa el correo registrado y enviaremos un enlace seguro para cambiar tu contrasena.
    </p>

    <div asp-validation-summary="ModelOnly" class="auth-validation mb-3"></div>

    <div class="auth-input-group">
        <i class="fa-solid fa-envelope auth-input-icon"></i>
        <input asp-for="Email"
               class="auth-input"
               autocomplete="email"
               placeholder="Correo electronico"
               aria-label="Correo electronico" />
    </div>
    <span asp-validation-for="Email" class="auth-field-error"></span>

    <button type="submit" class="auth-submit">
        <span>Enviar enlace</span>
        <i class="fa-solid fa-paper-plane"></i>
    </button>

    <div class="text-center mt-3">
        <a asp-action="Login" class="auth-link">Volver al login</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
