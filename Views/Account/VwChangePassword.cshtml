@model Tienda_Streaming.Models.Dto.Account.DtoChangePasswordViewModel

@{
    // Pantalla autenticada usada para reemplazar contrasenas temporales.
    Layout = "_AuthLayout";
    ViewData["Title"] = "Cambiar contrasena";
}

<form asp-action="ChangePassword" method="post" class="auth-form">
    <h2 class="auth-form-title">Cambia tu contrasena</h2>
    <p class="auth-form-copy">
        Estás usando una contrasena temporal. Define una nueva para continuar al sistema.
    </p>

    <div asp-validation-summary="ModelOnly" class="auth-validation mb-3"></div>

    <div class="auth-input-group">
        <i class="fa-solid fa-lock auth-input-icon"></i>
        <input asp-for="CurrentPassword" class="auth-input" autocomplete="current-password" placeholder="Contrasena actual" aria-label="Contrasena actual" />
    </div>
    <span asp-validation-for="CurrentPassword" class="auth-field-error"></span>

    <div class="auth-input-group">
        <i class="fa-solid fa-key auth-input-icon"></i>
        <input asp-for="Password" class="auth-input" autocomplete="new-password" placeholder="Nueva contrasena" aria-label="Nueva contrasena" />
    </div>
    <span asp-validation-for="Password" class="auth-field-error"></span>

    <div class="auth-input-group">
        <i class="fa-solid fa-shield-halved auth-input-icon"></i>
        <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" placeholder="Confirmar nueva contrasena" aria-label="Confirmar nueva contrasena" />
    </div>
    <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>

    <button type="submit" class="auth-submit">
        <span>Actualizar contrasena</span>
        <i class="fa-solid fa-key"></i>
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
