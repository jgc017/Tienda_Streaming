@model Tienda_Streaming.Models.Dto.Account.DtoResetPasswordViewModel

@{
    // Pantalla publica abierta desde el enlace enviado por correo.
    Layout = "_AuthLayout";
    ViewData["Title"] = "Nueva contrasena";
}

@* Envia nueva contrasena a POST /Account/ResetPassword junto al token oculto. *@
<form asp-action="ResetPassword" method="post" class="auth-form">
    <input type="hidden" asp-for="Token" />

    <h2 class="auth-form-title">Nueva contrasena</h2>
    <p class="auth-form-copy">
        Define una contrasena segura para recuperar el acceso al proyecto.
    </p>

    <div asp-validation-summary="ModelOnly" class="auth-validation mb-3"></div>

    <div class="auth-input-group">
        <i class="fa-solid fa-lock auth-input-icon"></i>
        <input asp-for="Password"
               class="auth-input"
               autocomplete="new-password"
               placeholder="Nueva contrasena"
               aria-label="Nueva contrasena" />
    </div>
    <span asp-validation-for="Password" class="auth-field-error"></span>

    <div class="auth-input-group">
        <i class="fa-solid fa-shield-halved auth-input-icon"></i>
        <input asp-for="ConfirmPassword"
               class="auth-input"
               autocomplete="new-password"
               placeholder="Confirmar contrasena"
               aria-label="Confirmar contrasena" />
    </div>
    <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>

    <button type="submit" class="auth-submit">
        <span>Actualizar contrasena</span>
        <i class="fa-solid fa-key"></i>
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
