@{
    // Confirmacion generica posterior a solicitar recuperacion de contrasena.
    Layout = "_AuthLayout";
    ViewData["Title"] = "Solicitud recibida";
}

<div class="auth-form text-center">
    <i class="fa-solid fa-circle-check auth-state-icon"></i>
    <h2 class="auth-form-title">Solicitud recibida</h2>
    <p class="auth-form-copy">
        Si el correo existe en el sistema, enviaremos un enlace para restablecer la contrasena.
    </p>
    <a asp-action="Login" class="auth-submit auth-submit-link">Volver al login</a>
</div>
