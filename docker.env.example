# Copia este archivo como .env y cambia los valores antes de levantar Docker.
# Nunca subas .env a Git.

TZ=America/Bogota
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
APPLY_MIGRATIONS_ON_STARTUP=true

# Si publicas detras de Nginx, Caddy, Traefik o IIS con HTTPS, pon true.
# Si expones el contenedor directamente, dejalo false.
TRUST_FORWARDED_HEADERS=false
REQUIRE_SECURE_COOKIES=true

POSTGRES_DB=Cuentas_Streaming
POSTGRES_USER=cuentas_streaming
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_SEGURA
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=correo_smtp@dominio.com
SMTP_PASSWORD=PASSWORD_APP_SMTP
SMTP_FROM_EMAIL=correo_smtp@dominio.com
SMTP_FROM_NAME=Tienda Streaming
# pgAdmin en Docker para administrar PostgreSQL desde navegador.
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@tiendastreaming.com
PGADMIN_DEFAULT_PASSWORD=CAMBIA_ESTA_PASSWORD_PGADMIN
CODIGOS_PLATAFORMAS_ENABLED=false
CODIGOS_PLATAFORMAS_HOST=imap.gmail.com
CODIGOS_PLATAFORMAS_PORT=993
CODIGOS_PLATAFORMAS_USE_SSL=true
CODIGOS_PLATAFORMAS_USERNAME=correo_codigos@dominio.com
CODIGOS_PLATAFORMAS_PASSWORD=PASSWORD_APP_IMAP
CODIGOS_PLATAFORMAS_FOLDER=INBOX
CODIGOS_PLATAFORMAS_POLL_INTERVAL_SECONDS=60
CODIGOS_PLATAFORMAS_MAX_MESSAGES_PER_SYNC=80
CODIGOS_PLATAFORMAS_RETENTION_HOURS=24
CODIGOS_PLATAFORMAS_CLEANUP_HOUR_LOCAL=3
CODIGOS_PLATAFORMAS_DELETE_FROM_MAILBOX_AFTER_IMPORT=true
